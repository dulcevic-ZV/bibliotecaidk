@model IEnumerable<AppWebBiblioteca.Models.Libro>;
@{
    ViewData["Title"] = "Listado de Libros";
}

<h1>@ViewData["Title"]</h1>

<p>Hay @Model.Count() Libros registrados.</p> 

<a class="btn btn-primary" asp-action="Create"> Nuevo libro +</a>


<div class="row">
    <form method="post">
        @foreach (var libro in Model)
        {
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@libro.Title</h5>
                        <h6>@libro.Autor</h6>
                        <h6>@libro.Price</h6>
                        <img src="Imagenes/libros.jpeg" alt="Sample Photo" style="width:200px;height:200px;"/>
                        <a asp-action="Details" asp-route-id="@libro.Id">Ver</a>
                        <button asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-danger">Eliminar</button>
                        <a asp-action="Update" asp-route-id="@libro.Id" class="btn btn-success">Editar</a>
                    </div>
                </div>
            </div>
        }
    </form>

   
</div>