 @model IEnumerable<AppWebBiblioteca.Models.Libro>;
@{
    ViewData["Title"] = "Listado de Libros";
}

<h1 class="Listado-libros">@ViewData["Title"]</h1>

<p>Hay @Model.Count() Libros registrados.</p> 

<a class="boton-libros btn btn-primary" asp-action="Create"> Nuevo libro +</a>


<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var libro in Model)
    {
        <div class="tarjeta-libro card h-100 shadow-sm product-car">
            <div class="card-body d-flex flex-column">
                <img src="@libro.Imagen" alt="Sample Photo" style="height: 200px; object-fit: contain;" />
                <h5 class="card-title text-center">@libro.Title</h5>
                <p class="card-text text-muted small flex-grow-1"> Autor: @libro.Autor</p>
                <p class="card-text text-muted small flex-grow-1"> Precio: @libro.Price</p>
                <a asp-action="Details" class="btn btn-secondary" asp-route-id="@libro.Id">Ver</a>
            </div>
        </div>
    }
</div>

<br />
<br />
<br />
