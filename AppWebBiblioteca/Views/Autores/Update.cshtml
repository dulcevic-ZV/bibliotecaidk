@model AppWebBiblioteca.Models.Autor;

@{
    ViewData["Title"] = "Editar autor";
}

<form asp-action="Update" method="post">
    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nacionalidad"></label>
        <input asp-for="Nacionalidad" class="form-control" />
        <span asp-validation-for="Nacionalidad"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaDeNacimiento"></label>
        <input asp-for="FechaDeNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaDeNacimiento"></span>
    </div>

    <button type="submit" class="btn btn-success">Editar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>