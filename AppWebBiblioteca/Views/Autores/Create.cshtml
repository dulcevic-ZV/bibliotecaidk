@model AppWebBiblioteca.Models.Autor;

@{
    ViewData["Title"] = "Crear autor";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control"/>
        <span asp-validation-for="Nombre"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nacionalidad"></label>
        <input asp-for="Nacionalidad" class="form-control" />
        <span asp-validation-for="Nacionalidad"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaDeNacimiento"></label>
        <input asp-for="FechaDeNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaDeNacimiento"></span>
    </div>

    <button type="submit" class="btn btn-success">Crear</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>