@model IEnumerable<AppWebBiblioteca.Models.Autor>;
@{
    ViewData["Title"] = "Listado de Autores";
}

<h1>@ViewData["Title"]</h1>

<p>Hay @Model.Count() Autores registrados.</p> <!-- suma los elementos -->

<a class="btn btn-primary" asp-action="Create"> Nuevo autor +</a>

<nav class="navbar bg-body-tertiary mb-3">
    <div class="container-fluid">
        <form class="d-flex" role="search" asp-action="GetById" asp-controller="Autores" method="get">
            <input name="id" class="form-control me-2" type="number" placeholder="Id del autor" aria-label="Search" />
            <button class="btn btn-outline-success" type="submit">Buscar</button>
        </form>
    </div>
</nav>


<div class="row">
    <form method="post">
        @foreach (var autor in Model)
        {
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@autor.Nombre</h5>
                        <h6>@autor.Nacionalidad</h6>
                        <p>Edad: @(DateTime.Now.Year - autor.FechaDeNacimiento.Year)</p>
                        <a asp-action="Details" asp-route-id="@autor.Id">Ver</a>
                        <button asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-danger">Eliminar</button>
                        <a asp-action="Update" asp-route-id="@autor.Id" class="btn btn-success">Editar</a>
                    </div>
                </div>
            </div>
        }
    </form>

   
</div>