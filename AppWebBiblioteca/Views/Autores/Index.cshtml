@model IEnumerable<AppWebBiblioteca.Models.Autor>;
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="h3 mb-0">@ViewData["Title"] <small class="text-muted">(@Model.Count())</small></h1>
    <a class="btn btn-dark" asp-action="Create">Nuevo Autor</a>
</div>


<div class="row">
    <form method="post">
        @foreach (var autor in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card mb-4 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@autor.Nombre</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@autor.Nacionalidad</h6>
                        <p class="card-text mb-3">Edad: <strong>@(DateTime.Now.Year - autor.FechaDeNacimiento.Year)</strong></p>


                       <div class="mt-auto d-flex justify-content-between align-items-center">
                           <a class="btn btn-outline-secondary" swal-edit-link="" asp-action="Details" asp-route-id="@autor.Id">Ver</a>
                           <form asp-action="Delete" method="post" asp-route-id="@autor.Id" class="swal-delete-form d-inline">
                               @Html.AntiForgeryToken()
                               <button type="submit" class="btn btn-danger">Eliminar</button>
                           </form>
                       </div>
                    </div>
                </div>
            </div>
        }
    </form>

   
</div>