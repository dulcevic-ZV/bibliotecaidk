            <a asp-controller="Home" asp-action="Acerca_de" class="btn btn-secondary">Conocer más</a>
        </div>
        <div class="col-md-6 text-center">
            <img src="~/Imagenes/Coco witch hat atelier.jpeg" class="img-fluid rounded shadow" alt="Biblioteca" />
        </div>
    </div>
</div>

