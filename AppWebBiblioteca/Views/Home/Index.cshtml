                    <p class="card-text">Catálogo inmenso con múltiples categorías.</p>
                </div>
            </div>
        </div>
        <!--servicio 2 -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <img src="~/Imagenes/descarga (2).jpeg" class="card-img-top" alt="servicio2" />
                <div class="card-body">
                    <p class="card-text">Envios a domicilio.</p>
                </div>
            </div>
        </div>
        <!--servicio 3 -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <img src="~/Imagenes/descarga (3).jpeg" class="card-img-top" alt="servicio3" />
                <div class="card-body">
                    <p class="card-text">Búsqueda especializada.</p>
                </div>
            </div>
        </div>
    </div>
</div>

