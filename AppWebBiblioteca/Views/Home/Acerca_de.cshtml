<header class="about-header">
    <h1>BibliotecaWHA</h1>
    <p>
        Sistema web para la administración y consulta de información de biblioteca
    </p>
</header>
<br />
<br />
<br />
<center>
    <img class="imagen-marco" src="~/Imagenes/descarga (7).jpeg" />
</center>
<br />
<br />
<br />
<hr />
<br />
<br />
<br />
<section class="about-container">
    <article class="about-content">
        <h2>
            ¿Quiénes somos?
        </h2>
        <p>
            Somos una biblioteca virtual que
            busca otorgarle a nuestros
            usuarios diversas opciones
            de libros, comics, mangas y revistas
            para todo tipo de gustos.
        </p>
        <p>
            Nuestra biblioteca tiene constantemente
            nuevo contenido de múltiples
            géneros literarios. Buscamos ser
            una opción ideal para aquellos
            lectores que desean tener múltiples
            opciones a elegir y que se
            atreven a probar nuevas cosas.
        </p>
    </article>
    <br />
    <aside class="about_info">
        <h3>Misión</h3>
        <p>
            Nuestra biblioteca asume la
            misión de brindar a los usuarios
            curiosos, amantes del conocimiento,
            de los mundos fantáticos y de la
            lectura, una opción para que
            disfruten de múltiples libros
            sin restricciones.
        </p>
        <h3>Visión</h3>
        <p>
            Nuestra visión es permitir
            a los usuarios tener las
            posibilidades de leer los
            libros que deseen sin
            limitaciones.
        </p>
    </aside>
</section>
<br />
<br />
<br />
<hr />
<div class="contenedor-acerca">
    <h2 class="text-center mb-4">Más acerca de nuestra biblioteca</h2>
    <div class="row">
        @await Html.PartialAsync("_ServiceCard", new AppWebBiblioteca.Models.serviceCard { ImageUrl = "/Imagenes/preguntas.jpeg", Text = "Preguntas frecuentes" })
        @await Html.PartialAsync("_ServiceCard", new AppWebBiblioteca.Models.serviceCard { ImageUrl = "/Imagenes/información.jpeg", Text = "Información sobre la biblioteca" })
        @await Html.PartialAsync("_ServiceCard", new AppWebBiblioteca.Models.serviceCard { ImageUrl = "/Imagenes/ubicacion.jpeg", Text = "Ubicación de la biblioteca" })
    </div>
</div>
<br />
<hr />
<br />
<div class="Acordion-clase">
    <h2>Algunos datos sobre la biblioteca</h2>
    <div>
        @await Html.PartialAsync("_AcordionService", new AppWebBiblioteca.Models.AcordionService { Titulo = "¿Cuántos años lleva funcionando?", Texto = "Llevamos 3 años otorgando nuestros servicios a nivel nacional. Desde el 2023.", Titulo2 = "¿Dónde se encuentran?"
        ,
            Texto2 = "Nos encontramos en la Av Independencia Sur Ent 21 y 23 Cl Ote Sta Ana No.95, San Salvador, El Salvador.",
            Titulo3 = "¿Realizan envios internacionales?",
            Texto3 = "Por ahora solo realizamos envios nacionales."
        })

    </div>
</div>
<br />
<hr />
<section class="team-section">
    <figure>
        <img src="~/Imagenes/qifrey.jpeg" alt="Biblioteca" />
        <figcaption>Biblioteca virtual desarrollada con ASP.NET MVC</figcaption>
    </figure>
</section>




