@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1 class="fw-bold mt-5" style="color: steelblue;">Iniciar Sesión</h1>

<img src="~/Imagenes/Descargar oro marco página divisor gratis.jpeg" class="img-fluid" alt="imagen">

<div style="margin-top:50px;" class="row">
    <div class="col-md-7">
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl"/>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-5">
                <label asp-for="UserNameOrEmail" class="form-label text-secondary" ></label>
                <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username"/>
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

             <div class="mb-5">
                <label asp-for="Password" class="form-label text-secondary"></label>
                <input asp-for="Password" class="form-control" autocomplete="username"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-5">
                <input asp-for="RememberMe" class="form-check-input"/>
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-outline-primary">Iniciar sesión</button>
            <a asp-action="Register" class="btn btn-primary">Crear una cuenta</a>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}