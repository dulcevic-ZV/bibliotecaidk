@model RegisterViewModel

@{
    ViewData["Title"] = "Registrarse";
}

<h1 class="fw-bold mt-5 text-center" style="color: steelblue;">Registrarse</h1>

<img src="~/Imagenes/Descargar oro marco página divisor gratis.jpeg" class="img-fluid mx-auto d-block" alt="imagen">

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Register" method="post" class="mb-5">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-5">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="userName"/>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="password"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
             <div class="mb-5">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex p-2 gap-2">
                <button type="submit" class="btn btn-primary">Registrarse</button>
                <a asp-action="Login" class="btn btn-outline-primary">Ya tengo una cuenta</a>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"></partial>
}
