@model AppWebBiblioteca.Models.UsuarioRol

@{
    var usersNotInRole = ViewBag.UsersNotInRole as List<Microsoft.AspNetCore.Identity.IdentityUser>;
}

<h1 class="mb-5">@Model.Role.Name</h1>
<a asp-action="Index" class="btn btn-outline-primary mb-5">Volver</a>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-primary fw-bold">
                Usuarios con este rol
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <p>@user.UserName</p>
                                <small class="text-muted">@user.Email</small>
                            </div>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="roleId" value="@Model.Role.Id" />
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted fst-italic">Ningún usuario tiene este rol.</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-primary fw-bold">
                Asignar usuarios al rol
            </div>
            <ul class="list-group list-group-flush">
                @if (usersNotInRole != null && usersNotInRole.Any())
                {
                    @foreach (var user in usersNotInRole)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <p>@user.UserName</p>
                                <p class="text-muted">@user.Email</p>
                            </div>
                            <form asp-action="Add" method="post">
                                <input type="hidden" name="roleId" value="@Model.Role.Id" />
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-primary">Agregar</button>
                            </form>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted fst-italic">Todos los usuarios ya tienen este rol.</li>
                }
            </ul>
        </div>
    </div>
</div>
